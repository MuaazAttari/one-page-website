<svg width="1200" height="630" xmlns="http://www.w3.org/2000/svg">
  <!-- Background -->
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#0a0a0a"/>
      <stop offset="100%" style="stop-color:#16213e"/>
    </linearGradient>
    <linearGradient id="text" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#00ffff"/>
      <stop offset="50%" style="stop-color:#22d3ee"/>
      <stop offset="100%" style="stop-color:#a78bfa"/>
    </linearGradient>
    <filter id="glow">
      <feGaussianBlur stdDeviation="3" result="coloredBlur"/>
      <feMerge>
        <feMergeNode in="coloredBlur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>
  
  <!-- Background -->
  <rect width="1200" height="630" fill="url(#bg)"/>
  
  <!-- Decorative Background Orbs -->
  <circle cx="100" cy="100" r="200" fill="rgba(0,255,255,0.08)"/>
  <circle cx="1100" cy="530" r="250" fill="rgba(167,139,250,0.08)"/>
  
  <!-- Name with Glow Effect -->
  <text x="600" y="200" text-anchor="middle" font-family="Arial, sans-serif" font-size="72" font-weight="800" fill="url(#text)" filter="url(#glow)" style="text-shadow: 0 0 30px rgba(0,255,255,0.5);">
    Muhammad Muaaz Ansari
  </text>
  
  <!-- Title -->
  <text x="600" y="280" text-anchor="middle" font-family="Arial, sans-serif" font-size="36" fill="#e5e7eb" font-weight="500">
    Web Developer &amp; AI Solutions Builder
  </text>
  
  <!-- Tech Stack Boxes -->
  <g transform="translate(600, 400)">
    <!-- Next.js -->
    <rect x="-480" y="-40" width="200" height="80" rx="12" fill="rgba(0,255,255,0.1)" stroke="rgba(0,255,255,0.4)" stroke-width="2"/>
    <text x="-380" y="15" text-anchor="middle" font-family="Arial, sans-serif" font-size="28" font-weight="600" fill="#00ffff">Next.js</text>
    
    <!-- Python -->
    <rect x="-260" y="-40" width="200" height="80" rx="12" fill="rgba(0,255,255,0.1)" stroke="rgba(0,255,255,0.4)" stroke-width="2"/>
    <text x="-160" y="15" text-anchor="middle" font-family="Arial, sans-serif" font-size="28" font-weight="600" fill="#00ffff">Python</text>
    
    <!-- AI/ML -->
    <rect x="-40" y="-40" width="200" height="80" rx="12" fill="rgba(0,255,255,0.1)" stroke="rgba(0,255,255,0.4)" stroke-width="2"/>
    <text x="60" y="15" text-anchor="middle" font-family="Arial, sans-serif" font-size="28" font-weight="600" fill="#00ffff">AI/ML</text>
    
    <!-- Tailwind -->
    <rect x="180" y="-40" width="200" height="80" rx="12" fill="rgba(0,255,255,0.1)" stroke="rgba(0,255,255,0.4)" stroke-width="2"/>
    <text x="280" y="15" text-anchor="middle" font-family="Arial, sans-serif" font-size="28" font-weight="600" fill="#00ffff">Tailwind</text>
  </g>
  
  <!-- GitHub -->
  <text x="600" y="560" text-anchor="middle" font-family="Arial, sans-serif" font-size="24" fill="#9ca3af" font-weight="500">
    github.com/MuaazAttari
  </text>
</svg>
